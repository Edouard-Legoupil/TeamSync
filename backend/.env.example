# Copy to `.env` and fill in the values.

# --- Database ---------------------------------------------------------------
# PostgreSQL (production). SQLite works out of the box for local dev:
#   sqlite:///./teamsync.db
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/teamsync

# --- Azure AD SSO -----------------------------------------------------------
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Must match a redirect URI registered on the Azure AD app:
#   local dev:  http://localhost:8000/api/auth/callback
#   production: https://<function-app>.azurewebsites.net/api/auth/callback
AZURE_AD_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Application JWT ---------------------------------------------------------
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET_KEY=dev-only-secret-change-me

# --- AI pipeline -------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional Azure OpenAI alternative (leave blank to use plain OpenAI):
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- App / frontend ----------------------------------------------------------
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
STATIC_DIR=../frontend/dist

# --- Developer conveniences ---------------------------------------------------
# Enable local login without Azure AD (MUST be false in production):
ALLOW_DEV_LOGIN=false
